{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axtp.dev/schemas/state-oracle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "scope", "observable_events", "context_outcomes", "rules"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "scope": { "const": "test-adapter-observable framing state; not a production runtime API" },
    "observable_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "meaning"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "meaning": { "type": "string", "minLength": 1 },
          "conditional_capability": { "type": "string", "minLength": 1 }
        }
      }
    },
    "context_outcomes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["partial", "completed", "invalidated", "abandoned_missing", "expired", "resource_exhausted", "cleared"] }
    },
    "rules": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
