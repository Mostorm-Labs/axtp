{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axtp.dev/schemas/frame-verification-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "authority", "release_required", "required_decisions", "required_cases", "adapter_capabilities"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "status": { "const": "release-required" },
    "authority": { "const": "AXTP-Core-Framing-Authority-v0.1" },
    "release_required": { "const": true },
    "required_decisions": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^A1-D(0[1-9]|10)$" }
    },
    "required_cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^frame\\.[a-z0-9_.-]+$" }
    },
    "adapter_capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_required", "optional"],
      "properties": {
        "core_required": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "optional": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
