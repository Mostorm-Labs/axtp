{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axtp.dev/schemas/virtual-time.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "clock", "operations", "policy_deadlines", "rules"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "clock": { "const": "monotonic_virtual" },
    "operations": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["advance_by", "advance_to_policy_deadline"] }
    },
    "policy_deadlines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "numeric_equality", "required_capability", "meaning"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "owner": { "enum": ["core", "runtime_or_profile"] },
          "numeric_equality": { "type": "boolean" },
          "required_capability": { "type": "string", "minLength": 1 },
          "meaning": { "type": "string", "minLength": 1 }
        }
      }
    },
    "rules": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
